##
# 1) Builder Stage
##
FROM node:18-alpine AS builder

# Create app directory
WORKDIR /app

# Copy the entire monorepo (including packages/, apps/, etc.)
# NOTE: If your .dockerignore excludes something critical, remove it from .dockerignore.
COPY . .

# Globally install pnpm, then install all dependencies in the monorepo
RUN npm install -g pnpm && \
    pnpm install --frozen-lockfile

# Build all packages (including the server)
# e.g. if "pnpm build" internally runs `turbo build` for the monorepo
RUN pnpm build


##
# 2) Final Stage
##
FROM node:18-alpine

# Create the app directory
WORKDIR /app

# Install netcat for health checks
RUN apk add --no-cache netcat-openbsd

# For the simplest approach, copy the entire server artifact from builder:
#  - Dist folder from apps/server
#  - Node_modules for the server (already built/installed in builder stage)
#  - drizzle directory if you use Drizzle migrations
#  - package.json so we know the version/metadata (optional but often useful)
COPY --from=builder /app/apps/server/dist ./dist
COPY --from=builder /app/apps/server/node_modules ./node_modules
COPY --from=builder /app/apps/server/package.json ./


# Create init script for waiting on the DB and running migrations
COPY <<EOF /docker-init.sh
#!/bin/sh

echo "🔍 Checking for database..."
until nc -z db 5432; do
    echo "⏳ Waiting for database..."
    sleep 2
done

echo "📦 Running database migrations..."
cd /app
pnpm db:generate
pnpm db:push

echo "🚀 Starting application..."
exec node dist/index.js
EOF

RUN chmod +x /docker-init.sh

# We’re exposing 4000 for clarity (the server uses 4000 by default)
EXPOSE 4000

CMD ["/docker-init.sh"]
